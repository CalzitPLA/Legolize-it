[Desktop Entry]
Type=Application
Name=Legolize it
GenericName=Parts into bricks
Comment=Turn an STL/STEP part into bricks: bricky, detailed, or artsy with parts on Technic axles; FreeCAD, STL stack, building manual, orders
Exec=legolize-it %f
Icon=legolize-it
Terminal=false
Categories=Graphics;3DGraphics;Engineering;
MimeType=model/stl;model/step;application/sla;model/x-ply;model/obj;model/3mf;model/gltf-binary;model/x-geomview-off;
Keywords=brick;voxel;STL;STEP;PLY;FreeCAD;3D printing;Technic;axle;artsy;building manual;
StartupNotify=true
StartupWMClass=Legolize it
Actions=artsy;bricky;

[Desktop Action artsy]
Name=Legolize it - artsy mode
Exec=legolize-it --artsy %f

[Desktop Action bricky]
Name=Legolize it - bricky mode
Exec=legolize-it --bricks-only %f
